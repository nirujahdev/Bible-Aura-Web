# Bible Aura Environment Configuration
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Configuration - OpenAI API
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Payment Integration (PayHere)
VITE_PAYHERE_MERCHANT_ID=your_merchant_id
VITE_PAYHERE_SANDBOX=true

# App Configuration
VITE_APP_NAME=Bible Aura
VITE_APP_URL=http://localhost:8080

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=your_ga_id

# Social Features (Optional)
VITE_FACEBOOK_APP_ID=your_facebook_app_id

# Instructions:
# 1. Get your OpenAI API key from: https://platform.openai.com/api-keys
# 2. Set up your Supabase project at: https://supabase.com/
# 3. Configure PayHere for payments at: https://www.payhere.lk/
# 4. Copy this file to .env.local and replace the placeholder values
# 5. IMPORTANT: Restart your dev server after adding/changing environment variables 