{
  "name": "bible-aura",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "lighthouse": "lighthouse https://bibleaura.xyz --output html --output-path ./lighthouse-report.html --chrome-flags='--headless'",
    "lighthouse-ci": "lhci autorun",
    "seo-audit": "lighthouse https://bibleaura.xyz --only-categories=seo --output json --output-path ./seo-audit.json",
    "performance-audit": "lighthouse https://bibleaura.xyz --only-categories=performance --output json --output-path ./performance-audit.json",
    "index-bible": "tsx scripts/index-bible-to-pinecone.ts",
    "index-cross-refs": "tsx scripts/index-cross-references-to-pinecone.ts",
    "index-cross-refs:win": "set NODE_OPTIONS=--max-old-space-size=8192 && tsx scripts/index-cross-references-to-pinecone.ts",
    "index-cross-refs:secure": "tsx scripts/index-cross-references-to-pinecone-secure.ts",
    "index-cross-refs:secure:win": "set NODE_OPTIONS=--max-old-space-size=8192 && tsx scripts/index-cross-references-to-pinecone-secure.ts",
    "index-cross-refs:resume": "tsx scripts/index-cross-references-to-pinecone-secure.ts --resume",
    "monitor-cross-refs": "tsx scripts/monitor-cross-ref-indexing.ts",
    "verify-cross-refs": "tsx scripts/verify-cross-references-pinecone.ts",
    "cleanup-indexed-cross-refs": "tsx scripts/cleanup-indexed-cross-refs.ts",
    "test-bible-pinecone": "tsx scripts/test-bible-pinecone.ts",
    "index-bible:ps1": "powershell -ExecutionPolicy Bypass -File scripts/run-bible-indexing.ps1",
    "test-bible:ps1": "powershell -ExecutionPolicy Bypass -File scripts/test-bible-setup.ps1"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@langchain/core": "^1.1.17",
    "@langchain/openai": "^1.2.3",
    "@openai/agents": "^0.3.0",
    "@openai/guardrails": "^0.1.4",
    "@pinecone-database/pinecone": "^6.1.3",
